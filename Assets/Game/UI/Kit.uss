:root {
    --graphite: #2a2a31;
    --graphite-soft: #6b6973;
    --red-dark: #b3121c;
    --dim: rgba(42, 42, 49, 0.38);
    --locked-tint: #6b6973;
    --locked-text: #e4e2ea;
    --me: #2e8c33;
    --font-regular: url("project://database/Assets/Game/Art/Fonts/ShantellSans-Regular-SDF.asset?fileID=11400000&guid=967c3279ade608b40b20ffda73203427&type=2#ShantellSans-Regular-SDF");
    --font-bold: url("project://database/Assets/Game/Art/Fonts/ShantellSans-Bold-SDF.asset?fileID=11400000&guid=795ff5bd022bb8d45bac1520bdbca273&type=2#ShantellSans-Bold-SDF");
    --font-extrabold: url("project://database/Assets/Game/Art/Fonts/ShantellSans-ExtraBold-SDF.asset?fileID=11400000&guid=c6922b65e351b154298fda98c71845e1&type=2#ShantellSans-ExtraBold-SDF");
}

.hidden {
    display: none;
}

.unity-label {
    margin: 0;
    padding: 0;
    white-space: normal;
}

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.dim, .modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.dim {
    background-color: var(--dim);
}

.button {
    height: 96px;
    min-width: 300px;
    margin: 0;
    flex-shrink: 1;
    white-space: nowrap;
    padding: 26px 72px 44px 72px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Game/Art/UI/Menu/buttonRed.png?fileID=21300000&guid=d1231f51749d934418cb75a4fc00f4e2&type=3#buttonRed");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 26;
    -unity-slice-bottom: 34;
    -unity-font-definition: var(--font-bold);
    -unity-font-style: bold;
    font-size: 34px;
    color: #ffffff;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--graphite);
    -unity-text-align: middle-center;
    transition-property: translate, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-back;
}

.button:hover {
    background-color: rgba(0, 0, 0, 0);
    translate: 0 -3px;
    scale: 1.03 1.03;
}

.button:active {
    background-color: rgba(0, 0, 0, 0);
    translate: 0 1px;
    scale: 0.97 0.97;
}

.button:focus {
    background-color: rgba(0, 0, 0, 0);
}

.button--amber {
    background-image: url("project://database/Assets/Game/Art/UI/Menu/buttonAmber.png?fileID=21300000&guid=aeccd5b939ea2824e9a04672df9652b3&type=3#buttonAmber");
}

.button--paper {
    background-image: url("project://database/Assets/Game/Art/UI/Menu/buttonPaper.png?fileID=21300000&guid=34193004ad5d9df4395246ffdb9a7819&type=3#buttonPaper");
    -unity-font-style: normal;
    color: var(--graphite);
    -unity-text-outline-width: 0;
}

.button--small {
    height: 84px;
    font-size: 30px;
}

.button--wide {
    min-width: 360px;
}

.button--big {
    height: 112px;
    min-width: 420px;
    font-size: 44px;
}

.button--locked {
    background-image: url("project://database/Assets/Game/Art/UI/Menu/buttonPaper.png?fileID=21300000&guid=34193004ad5d9df4395246ffdb9a7819&type=3#buttonPaper");
    -unity-background-image-tint-color: var(--locked-tint);
    -unity-font-style: normal;
    color: var(--locked-text);
    -unity-text-outline-width: 0;
}

.button--locked:hover, .button--locked:active {
    translate: 0 0;
    scale: 1 1;
}

.lock-tip {
    display: none;
    position: absolute;
    left: 100%;
    top: 50%;
    margin-left: 16px;
    height: 50px;
    padding: 0 32px 2px 32px;
    background-image: url("project://database/Assets/Game/Art/UI/Menu/chip.png?fileID=21300000&guid=991e53dc3d9e3da4b964699a4a03c7ce&type=3#chip");
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-font-definition: var(--font-bold);
    -unity-font-style: normal;
    font-size: 22px;
    color: var(--graphite);
    -unity-text-outline-width: 0;
    -unity-text-align: middle-center;
    white-space: nowrap;
    opacity: 0;
    translate: -8px -50%;
    transition-property: opacity, translate;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.button--locked > .lock-tip {
    display: flex;
}

.button--locked:hover > .lock-tip {
    opacity: 1;
    translate: 0 -50%;
}

.card {
    background-image: url("project://database/Assets/Game/Art/UI/Menu/card.png?fileID=21300000&guid=f0ffc4c29b0d62041becd9bcf2e5fe76&type=3#card");
    -unity-slice-left: 56;
    -unity-slice-top: 52;
    -unity-slice-right: 60;
    -unity-slice-bottom: 60;
    padding: 52px 78px 60px 78px;
}

.tape {
    position: absolute;
    width: 150px;
    height: 55px;
    background-image: url("project://database/Assets/Game/Art/UI/Menu/tape.png?fileID=21300000&guid=2afef41f469e04c4e99effa05a51750f&type=3#tape");
    -unity-background-scale-mode: stretch-to-fill;
}

.tape--left {
    left: -2px;
    top: -12px;
    rotate: -14deg;
}

.tape--right {
    right: -6px;
    top: -8px;
    rotate: 11deg;
}

.title {
    -unity-font-definition: var(--font-extrabold);
    font-size: 56px;
    margin-top: -6.72px;
    margin-bottom: -0.72px;
}

.subtitle {
    font-size: 28px;
    color: var(--graphite-soft);
}

.divider {
    height: 20px;
    margin: 4px -10px 18px -10px;
    background-image: url("project://database/Assets/Game/Art/UI/Menu/divider.png?fileID=21300000&guid=bee3c801c4381c04ba803a23893e4af2&type=3#divider");
    -unity-slice-left: 16;
    -unity-slice-right: 16;
}

.label {
    -unity-font-definition: var(--font-bold);
    font-size: 24px;
    color: var(--graphite-soft);
    margin-bottom: 6px;
}

.hint {
    font-size: 22px;
    color: var(--graphite-soft);
    white-space: normal;
}

.hint--big {
    font-size: 26px;
}

.error {
    -unity-font-definition: var(--font-bold);
    font-size: 22px;
    color: var(--red-dark);
    margin-top: 6px;
}

.field {
    margin: 0;
    height: 74px;
    white-space: nowrap;
    --unity-cursor-color: var(--graphite);
    --unity-selection-color: rgba(239, 74, 60, 0.35);
}

.field > .unity-base-text-field__input {
    background-image: url("project://database/Assets/Game/Art/UI/Menu/field.png?fileID=21300000&guid=cf14ccf56bcf40e48980a78291f8ef9a&type=3#field");
    -unity-slice-left: 24;
    -unity-slice-top: 24;
    -unity-slice-right: 24;
    -unity-slice-bottom: 24;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding: 0 22px 2px 22px;
    margin: 0;
    -unity-font-definition: var(--font-regular);
    font-size: 32px;
    color: var(--graphite);
    -unity-text-align: middle-left;
}

.field:focus > .unity-base-text-field__input, .field--error > .unity-base-text-field__input {
    background-image: url("project://database/Assets/Game/Art/UI/Menu/fieldFocus.png?fileID=21300000&guid=fc45805bf23a15f4f99d4fba96aee225&type=3#fieldFocus");
}

.field > .unity-base-text-field__input--placeholder {
    color: var(--graphite-soft);
}

.chip {
    flex-direction: row;
    align-items: center;
    height: 50px;
    padding: 0 32px 2px 32px;
    margin: 0 12px 12px 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Game/Art/UI/Menu/chip.png?fileID=21300000&guid=991e53dc3d9e3da4b964699a4a03c7ce&type=3#chip");
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
}

.chip__text {
    -unity-font-definition: var(--font-bold);
    font-size: 22px;
    white-space: nowrap;
}

.chip__note {
    font-size: 22px;
    color: var(--graphite-soft);
    margin-left: 8px;
    white-space: nowrap;
}

.chip__note--before {
    margin-left: 0;
    margin-right: 8px;
}

.chip__copy {
    width: 32px;
    height: 32px;
    margin: 0 0 0 10px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Game/Art/UI/Menu/copy.png?fileID=21300000&guid=8dc52d7457df13d4d8a3a859fe5ec211&type=3#copy");
    -unity-background-scale-mode: scale-to-fit;
}

.chip__copy:hover, .chip__copy:active, .chip__copy:focus {
    background-color: rgba(0, 0, 0, 0);
}

.chip__copy:hover {
    scale: 1.12 1.12;
}

.chip.unity-button {
    transition-property: translate;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-back;
}

.chip.unity-button:hover, .chip.unity-button:active, .chip.unity-button:focus {
    background-color: rgba(0, 0, 0, 0);
}

.chip.unity-button:hover {
    translate: 0 -2px;
}

.status-dot {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border-width: 2px;
    border-color: var(--graphite);
    background-color: #5cbf4a;
    margin-right: 10px;
}

.row {
    flex-direction: row;
    align-items: flex-end;
}

.wrap {
    flex-direction: row;
    flex-wrap: wrap;
}

.grow {
    flex-grow: 1;
}

.gap {
    width: 24px;
}

.spacer {
    height: 24px;
}

.actions {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 30px;
}

.actions--center {
    justify-content: center;
}

.modal {
    align-items: center;
    justify-content: center;
}
