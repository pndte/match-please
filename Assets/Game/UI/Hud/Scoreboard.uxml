<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Kit.uss" />
    <Style src="Hud.uss" />
    <ui:VisualElement name="scoreboard" class="scoreboard-dock" picking-mode="Ignore">
        <ui:VisualElement class="panel scoreboard" picking-mode="Ignore">
            <ui:Label text="Статистика матча" class="scoreboard__title" picking-mode="Ignore" />
            <ui:VisualElement class="scoreboard__columns" picking-mode="Ignore">
                <ui:Label text="#" class="label scoreboard__place" picking-mode="Ignore" />
                <ui:Label text="Игрок" class="label scoreboard__player" picking-mode="Ignore" />
                <ui:Label text="Убийства" class="label scoreboard__number" picking-mode="Ignore" />
                <ui:Label text="Урон" class="label scoreboard__number" picking-mode="Ignore" />
                <ui:Label text="Смерти" class="label scoreboard__number" picking-mode="Ignore" />
                <ui:Label text="К/Д" class="label scoreboard__number" picking-mode="Ignore" />
                <ui:Label text="УР/К" class="label scoreboard__number" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="rows" class="scoreboard__rows" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
