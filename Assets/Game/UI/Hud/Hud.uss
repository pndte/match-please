.match-hud {
    flex-grow: 1;
    -unity-font-definition: var(--font-regular);
    color: var(--graphite);
}

.dim--light {
    background-color: rgba(42, 42, 49, 0.22);
}

.kill-feed {
    position: absolute;
    top: 20px;
    right: 24px;
    align-items: flex-end;
}

.kill {
    flex-direction: row;
    align-items: center;
    height: 44px;
    margin-bottom: 6px;
    padding: 0 20px 6px 18px;
    background-image: url("project://database/Assets/Game/Art/UI/Hud/tile.png?fileID=21300000&guid=7e6203f2d5ca73c4cad963f34e9c5ea7&type=3#tile");
    -unity-slice-left: 18;
    -unity-slice-top: 16;
    -unity-slice-right: 20;
    -unity-slice-bottom: 20;
    transition-property: opacity, translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-cubic;
}

.kill--mine {
    -unity-background-image-tint-color: #fff0b3;
}

.kill--mine-death {
    -unity-background-image-tint-color: #ffd3cc;
}

.kill--entering {
    opacity: 0;
    translate: 40px 0;
}

.kill--leaving {
    opacity: 0;
    transition-duration: 0.6s;
}

.kill__name {
    -unity-font-definition: var(--font-bold);
    font-size: 20px;
    color: var(--graphite);
    white-space: nowrap;
}

.kill__name--me {
    color: var(--me);
}

.kill__weapon {
    margin: 0 10px;
}

.weapon-icon {
    height: 30px;
    -unity-background-scale-mode: scale-to-fit;
}

.weapon-icon--ak {
    width: 96px;
    background-image: url("project://database/Assets/Game/Art/UI/Hud/weapon_ak.png?fileID=21300000&guid=f2bd463abce565c4589ecbd9a1312032&type=3#weapon_ak");
}

.weapon-icon--shotgun {
    width: 120px;
    background-image: url("project://database/Assets/Game/Art/UI/Hud/weapon_shotgun.png?fileID=21300000&guid=c065fca9228433e42ab4e225c1fc5b16&type=3#weapon_shotgun");
}

.weapon-icon--pistol {
    width: 40px;
    background-image: url("project://database/Assets/Game/Art/UI/Hud/weapon_pistol.png?fileID=21300000&guid=53a851f0e0bc34e4cbe1d727265d3f16&type=3#weapon_pistol");
}

.weapon-icon--sniper {
    width: 120px;
    background-image: url("project://database/Assets/Game/Art/UI/Hud/weapon_sniper.png?fileID=21300000&guid=4894426de8fc6fe4e88f11e90e7a9443&type=3#weapon_sniper");
}

.weapon-icon--fists {
    width: 30px;
    background-image: url("project://database/Assets/Game/Art/UI/Hud/weapon_fists.png?fileID=21300000&guid=7c40235f06d4e944cba5b16e121184a1&type=3#weapon_fists");
}

.scoreboard {
    width: 980px;
}

.scoreboard__columns {
    flex-direction: row;
    align-items: flex-end;
    padding: 0 12px;
    margin-bottom: 4px;
}

.scoreboard__place {
    width: 56px;
    margin-bottom: 0;
    -unity-text-align: middle-center;
}

.scoreboard__player {
    flex-grow: 1;
    margin-bottom: 0;
}

.scoreboard__number {
    width: 140px;
    margin-bottom: 0;
    -unity-text-align: middle-center;
}

.score-row {
    flex-direction: row;
    align-items: center;
    height: 54px;
    padding: 0 12px;
    border-radius: 10px;
}

.score-row--odd {
    background-color: rgba(42, 42, 49, 0.045);
}

.score-row--me {
    background-color: rgba(120, 214, 84, 0.2);
}

.score-row--leader {
    background-color: rgba(255, 240, 179, 0.95);
}

.score-row__place {
    width: 56px;
    -unity-font-definition: var(--font-bold);
    font-size: 24px;
    color: var(--graphite-soft);
    -unity-text-align: middle-center;
}

.score-row__player {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.score-row__crown {
    display: none;
    width: 40px;
    height: 35px;
    margin-right: 8px;
    background-image: url("project://database/Assets/Game/Art/UI/Hud/crown.png?fileID=21300000&guid=d6a7eaa34d9243f48a2b55bbf2fba08e&type=3#crown");
    -unity-background-scale-mode: scale-to-fit;
    rotate: -12deg;
}

.score-row--leader .score-row__crown {
    display: flex;
}

.score-row__name {
    -unity-font-definition: var(--font-bold);
    font-size: 26px;
    color: var(--graphite);
    white-space: nowrap;
}

.score-row--me .score-row__name {
    color: var(--me);
}

.score-row__you {
    display: none;
    margin-left: 10px;
    padding: 0 10px 2px 10px;
    border-radius: 9px;
    background-color: var(--me);
    -unity-font-definition: var(--font-bold);
    font-size: 16px;
    color: #ffffff;
}

.score-row--me .score-row__you {
    display: flex;
}

.score-row__number {
    width: 140px;
    -unity-font-definition: var(--font-bold);
    font-size: 26px;
    color: var(--graphite);
    -unity-text-align: middle-center;
}

.score-row__kd {
    color: var(--graphite-soft);
}
