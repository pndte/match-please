.match-hud {
    flex-grow: 1;
    -unity-font-definition: var(--font-regular);
    color: var(--graphite);
}

.kill-feed {
    position: absolute;
    top: 20px;
    right: 24px;
    align-items: flex-end;
}

.kill {
    flex-direction: row;
    align-items: center;
    height: 44px;
    margin-bottom: 6px;
    padding: 0 20px 6px 18px;
    background-image: url("project://database/Assets/Game/Art/UI/Hud/tile.png?fileID=21300000&guid=7e6203f2d5ca73c4cad963f34e9c5ea7&type=3#tile");
    -unity-slice-left: 18;
    -unity-slice-top: 16;
    -unity-slice-right: 20;
    -unity-slice-bottom: 20;
    transition-property: opacity, translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-cubic;
}

.kill--mine {
    -unity-background-image-tint-color: #fff0b3;
}

.kill--mine-death {
    -unity-background-image-tint-color: #ffd3cc;
}

.kill--entering {
    opacity: 0;
    translate: 40px 0;
}

.kill--leaving {
    opacity: 0;
    transition-duration: 0.6s;
}

.kill__name {
    -unity-font-definition: var(--font-bold);
    font-size: 20px;
    color: var(--graphite);
    white-space: nowrap;
}

.kill__name--me {
    color: var(--me);
}

.kill__weapon {
    margin: 0 10px;
}

.weapon-icon {
    height: 30px;
    max-width: 120px;
    -unity-background-scale-mode: scale-to-fit;
}

.scoreboard-dock {
    position: absolute;
    left: 0;
    right: 0;
    top: 48px;
    align-items: center;
}

.scoreboard {
    width: 860px;
}

.scoreboard__title {
    -unity-font-definition: var(--font-extrabold);
    font-size: 28px;
    margin: 0 0 4px 8px;
}

.scoreboard__columns {
    flex-direction: row;
    align-items: flex-end;
    padding: 0 10px;
    margin-bottom: 2px;
}

.scoreboard__columns > .label {
    font-size: 18px;
}

.scoreboard__place {
    width: 40px;
    margin-bottom: 0;
    -unity-text-align: middle-center;
}

.scoreboard__player {
    flex-grow: 1;
    margin-bottom: 0;
}

.scoreboard__number {
    width: 100px;
    margin-bottom: 0;
    -unity-text-align: middle-center;
}

.score-row {
    flex-direction: row;
    align-items: center;
    height: 42px;
    padding: 0 10px;
    border-radius: 8px;
}

.score-row--odd {
    background-color: rgba(42, 42, 49, 0.045);
}

.score-row--me {
    background-color: rgba(120, 214, 84, 0.2);
}

.score-row--leader {
    background-color: rgba(255, 240, 179, 0.95);
}

.score-row__place {
    width: 40px;
    -unity-font-definition: var(--font-bold);
    font-size: 20px;
    color: var(--graphite-soft);
    -unity-text-align: middle-center;
}

.score-row__player {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.score-row__crown {
    display: none;
    width: 32px;
    height: 28px;
    margin-right: 6px;
    background-image: url("project://database/Assets/Game/Art/UI/Hud/crown.png?fileID=21300000&guid=d6a7eaa34d9243f48a2b55bbf2fba08e&type=3#crown");
    -unity-background-scale-mode: scale-to-fit;
    rotate: -12deg;
}

.score-row--leader .score-row__crown {
    display: flex;
}

.score-row__name {
    -unity-font-definition: var(--font-bold);
    font-size: 22px;
    color: var(--graphite);
    white-space: nowrap;
}

.score-row--me .score-row__name {
    color: var(--me);
}

.score-row__you {
    display: none;
    margin-left: 8px;
    padding: 0 8px 2px 8px;
    border-radius: 8px;
    background-color: var(--me);
    -unity-font-definition: var(--font-bold);
    font-size: 14px;
    color: #ffffff;
}

.score-row--me .score-row__you {
    display: flex;
}

.score-row__number {
    width: 100px;
    -unity-font-definition: var(--font-bold);
    font-size: 22px;
    color: var(--graphite);
    -unity-text-align: middle-center;
}

.score-row__ratio {
    color: var(--graphite-soft);
}

.winner {
    width: 640px;
    align-items: center;
}

.winner__title {
    -unity-font-definition: var(--font-bold);
    font-size: 26px;
    color: var(--graphite-soft);
}

.winner__stage {
    width: 320px;
    height: 300px;
    margin-top: 8px;
}

.winner__burst {
    position: absolute;
    left: 0;
    top: 0;
    width: 320px;
    height: 300px;
    background-image: url("project://database/Assets/Game/Art/UI/Hud/burst.png?fileID=21300000&guid=8f04ade77d3798a46bf10ec42e382b22&type=3#burst");
    -unity-background-scale-mode: scale-to-fit;
}

.winner__figure {
    position: absolute;
    left: 50px;
    top: 62px;
    width: 220px;
    height: 220px;
    -unity-background-scale-mode: scale-to-fit;
}

.winner__crown {
    position: absolute;
    left: 116px;
    top: 34px;
    width: 88px;
    height: 77px;
    background-image: url("project://database/Assets/Game/Art/UI/Hud/crown.png?fileID=21300000&guid=d6a7eaa34d9243f48a2b55bbf2fba08e&type=3#crown");
    -unity-background-scale-mode: scale-to-fit;
    rotate: -10deg;
}

.winner__name {
    -unity-font-definition: var(--font-extrabold);
    font-size: 60px;
    margin-top: 2px;
    white-space: nowrap;
}

.winner__stats {
    flex-direction: row;
    margin-top: 12px;
    padding: 8px 6px 10px 6px;
    border-radius: 12px;
    background-color: rgba(255, 240, 179, 0.75);
}

.winner__stat {
    width: 92px;
    align-items: center;
}

.winner__stat-label {
    font-size: 16px;
    color: var(--graphite-soft);
    white-space: nowrap;
}

.winner__stat-value {
    -unity-font-definition: var(--font-extrabold);
    font-size: 26px;
    white-space: nowrap;
}

.winner__next {
    margin-top: 16px;
}
