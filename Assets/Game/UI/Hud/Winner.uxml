<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Kit.uss" />
    <Style src="Hud.uss" />
    <ui:VisualElement name="winner" class="modal" picking-mode="Ignore">
        <ui:VisualElement class="card winner">
            <ui:VisualElement class="tape tape--left" picking-mode="Ignore" />
            <ui:VisualElement class="tape tape--right" picking-mode="Ignore" />
            <ui:Label name="title" text="Победитель матча" class="winner__title" picking-mode="Ignore" />
            <ui:VisualElement class="winner__stage" picking-mode="Ignore">
                <ui:VisualElement class="winner__burst" picking-mode="Ignore" />
                <ui:VisualElement name="figure" class="winner__figure" picking-mode="Ignore" style="background-image: url(&apos;project://database/Assets/Game/Art/Characters/PencilPals.png?fileID=-1530501530&amp;guid=d31afdac7321b334a9dde2198a0dfb1c&amp;type=3#matvey_idle_0&apos;);" />
                <ui:VisualElement class="winner__crown" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="nickname" text="Лёха" class="winner__name" picking-mode="Ignore" />
            <ui:VisualElement class="winner__stats" picking-mode="Ignore">
                <ui:VisualElement class="winner__stat" picking-mode="Ignore">
                    <ui:Label text="убийства" class="winner__stat-label" picking-mode="Ignore" />
                    <ui:Label name="kills" text="12" class="winner__stat-value" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="winner__stat" picking-mode="Ignore">
                    <ui:Label text="урон" class="winner__stat-label" picking-mode="Ignore" />
                    <ui:Label name="damage" text="1840" class="winner__stat-value" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="winner__stat" picking-mode="Ignore">
                    <ui:Label text="смерти" class="winner__stat-label" picking-mode="Ignore" />
                    <ui:Label name="deaths" text="4" class="winner__stat-value" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="winner__stat" picking-mode="Ignore">
                    <ui:Label text="К/Д" class="winner__stat-label" picking-mode="Ignore" />
                    <ui:Label name="kd" text="3.00" class="winner__stat-value" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="winner__stat" picking-mode="Ignore">
                    <ui:Label text="УР/К" class="winner__stat-label" picking-mode="Ignore" />
                    <ui:Label name="damage-per-kill" text="153" class="winner__stat-value" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="next" text="Новый матч через 10 с" class="hint winner__next" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
