<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Kit.uss" />
    <Style src="Menu.uss" />
    <ui:VisualElement name="character-select" class="select" picking-mode="Ignore">
        <ui:VisualElement class="chip select__server">
            <ui:VisualElement class="status-dot" />
            <ui:Label name="server" text="26.12.34.56:7777 · игроков: 3" class="chip__text" />
        </ui:VisualElement>
        <ui:Label text="Выбери персонажа" class="title" />
        <ui:VisualElement class="cast">
            <ui:Button name="sanya" class="character">
                <ui:VisualElement class="character__check" picking-mode="Ignore" />
                <ui:VisualElement class="character__portrait" picking-mode="Ignore">
                    <ui:VisualElement class="character__figure character__figure--sanya" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="Саня" class="character__name" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="seva" class="character character--selected">
                <ui:VisualElement class="character__check" picking-mode="Ignore" />
                <ui:VisualElement class="character__portrait" picking-mode="Ignore">
                    <ui:VisualElement class="character__figure character__figure--seva" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="Сева" class="character__name" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="matvey" class="character">
                <ui:VisualElement class="character__check" picking-mode="Ignore" />
                <ui:VisualElement class="character__portrait" picking-mode="Ignore">
                    <ui:VisualElement class="character__figure character__figure--matvey" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="Матвей" class="character__name" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="goshak" class="character">
                <ui:VisualElement class="character__check" picking-mode="Ignore" />
                <ui:VisualElement class="character__portrait" picking-mode="Ignore">
                    <ui:VisualElement class="character__figure character__figure--goshak" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="Гошак" class="character__name" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement class="select__actions" picking-mode="Ignore">
            <ui:Button name="disconnect" text="Отключиться" class="button button--paper button--small" />
            <ui:Button name="fight" text="В бой!" class="button button--big" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
