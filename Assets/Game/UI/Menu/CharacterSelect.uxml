<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="CharacterCard" src="CharacterCard.uxml" />
    <Style src="../Kit.uss" />
    <Style src="Menu.uss" />
    <ui:VisualElement name="character-select" class="select" picking-mode="Ignore">
        <ui:VisualElement class="chip select__server">
            <ui:VisualElement class="status-dot" />
            <ui:Label name="server" text="26.12.34.56:7777 · игроков: 3" class="chip__text" />
        </ui:VisualElement>
        <ui:Label text="Выбери персонажа" class="title" />
        <ui:VisualElement class="cast">
            <ui:Instance template="CharacterCard" name="character-sample" />
        </ui:VisualElement>
        <ui:VisualElement class="select__actions" picking-mode="Ignore">
            <ui:Button name="disconnect" text="Отключиться" class="button button--paper button--small" />
            <ui:Button name="fight" text="В бой!" class="button button--big" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
